{
  "name": "bayt-kahraba-theme",
  "version": "2.0.0",
  "private": true,
  "description": "Build pipeline for the Bayt Al-Kahraba WooCommerce theme (Tailwind CSS + a tiny vanilla JS bundle via esbuild).",
  "scripts": {
    "build": "npm run fonts && npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/dist/main.css --minify",
    "build:js": "esbuild assets/js/src/app.js --bundle --minify --target=es2019 --outfile=assets/js/dist/app.js && esbuild assets/js/src/admin.js --bundle --minify --target=es2019 --outfile=assets/js/dist/admin.js",
    "fonts": "node scripts/copy-fonts.mjs",
    "dev:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/dist/main.css --watch",
    "dev:js": "esbuild assets/js/src/app.js --bundle --sourcemap --target=es2019 --outfile=assets/js/dist/app.js --watch",
    "lint:php": "node scripts/lint-php.mjs",
    "zip": "cd .. && tar -a -c -f bayt-kahraba/dist/bayt-kahraba.zip --exclude=bayt-kahraba/node_modules --exclude=bayt-kahraba/dist --exclude=bayt-kahraba/playground --exclude=bayt-kahraba/.git --exclude=bayt-kahraba/package-lock.json bayt-kahraba",
    "pin": "node scripts/pin-blueprint.mjs"
  },
  "devDependencies": {
    "@fontsource/alexandria": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.0.20",
    "esbuild": "0.23.1",
    "php-parser": "3.1.5",
    "tailwindcss": "3.4.10"
  }
}
